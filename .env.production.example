# ==========================================================================
# آب پاک | ABPAK — نمونه تنظیمات پروداکشن
#   cp .env.production.example .env
# سپس همه مقادیر «change-me» و دامنه‌ها را جایگزین کنید. این فایل و .env
# هرگز نباید در گیت قرار بگیرند (در .gitignore هستند).
# ==========================================================================

# ------------------------------------------------------------- هسته جنگو
# الزامی است؛ با دستور زیر بسازید:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-key
# در پروداکشن همیشه 0
DJANGO_DEBUG=0
# دامنه واقعی سایت؛ 127.0.0.1 برای healthcheck داخلی لازم است
DJANGO_ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1
# مبدأهای مجاز فرم‌های POST (با https)
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ------------------------------------------------ امنیت (بعد از فعال‌سازی TLS)
# پس از تنظیم گواهی SSL این سه مقدار را روشن کنید:
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1

# سطح لاگ: DEBUG / INFO / WARNING / ERROR
DJANGO_LOG_LEVEL=INFO

# سرو فایل‌های آپلودی توسط جنگو (تا وقتی پروکسی برای /media تنظیم نشده)
DJANGO_SERVE_MEDIA=1

# --------------------------------------------------------- پایگاه داده
# برای اجرای دستورها روی هاست از پورت پابلیش‌شده استفاده کنید؛
# داخل docker-compose این مقدار با آدرس داخلی سرویس postgres جایگزین می‌شود.
DATABASE_URL=postgres://abpak:change-me-strong-password@127.0.0.1:5434/abpak
DB_CONN_MAX_AGE=600

POSTGRES_DB=abpak
POSTGRES_USER=abpak
# رمز قوی و یکتا انتخاب کنید (بدون $ و " تا با compose تداخل نکند)
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------ Redis
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6380/1
CACHE_TIMEOUT=900

# --------------------------------------------------- کارهای پس‌زمینه (سلری)
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/0

# --------------------------------------------------------------- پرداخت
PAYMENT_GATEWAY=zarinpal
PAYMENT_GATEWAY_ENABLED=1
# merchant id واقعی از پنل زرین‌پال
ZARINPAL_MERCHANT_ID=change-me-zarinpal-merchant-id
# 0 = پرداخت واقعی، 1 = سندباکس
ZARINPAL_SANDBOX=0
ZARINPAL_TIMEOUT=12

# ---------------------------------------------------------------- gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
