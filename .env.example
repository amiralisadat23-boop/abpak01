# ==========================================================================
# آب پاک | ABPAK — نمونه فایل تنظیمات محیطی
# این فایل را به .env کپی کنید و مقادیر واقعی را جایگزین کنید:
#   cp .env.example .env
# فایل .env در .gitignore است و هرگز نباید کامیت شود.
# ==========================================================================

# ------------------------------------------------------------- هسته جنگو
# با دستور زیر یک کلید امن جدید بسازید:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key
# 1 = توسعه (خطاها نمایش داده می‌شوند)، 0 = پروداکشن
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --------------------------------------------------------- پایگاه داده
# PostgreSQL (مقدار پیش‌فرض docker-compose با پورت پابلیش‌شده روی هاست)
DATABASE_URL=postgres://abpak:change-me@127.0.0.1:5434/abpak
# اگر خالی بماند، برای توسعه سریع SQLite استفاده می‌شود:
# DATABASE_URL=
DB_CONN_MAX_AGE=600

# اطلاعات ساخت دیتابیس در docker-compose (باید با DATABASE_URL هم‌خوان باشد)
POSTGRES_DB=abpak
POSTGRES_USER=abpak
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------ Redis
# کش، صف سلری و بک‌اند نتیجه
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_BACKEND=django_redis.cache.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6380/1
CACHE_TIMEOUT=900

# --------------------------------------------------- کارهای پس‌زمینه (سلری)
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/0

# --------------------------------------------------------------- پرداخت
PAYMENT_GATEWAY=zarinpal
PAYMENT_GATEWAY_ENABLED=1
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=1
ZARINPAL_TIMEOUT=12
